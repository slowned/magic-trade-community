POSTGRES_PASSWORD=changeme
DJANGO_DEBUG=True

# Generar una propia, nunca reutilizar esta ni la de settings.py históricamente commiteada:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#%^&*(-_=+)') for _ in range(50)))"
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key

# Hosts/orígenes separados por coma. Agregar la IP LAN si vas a probar desde el celular.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
